CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_LWIP_IPV6=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="@AVM_PARTITION_TABLE_FILENAME@"
CONFIG_APP_REPRODUCIBLE_BUILD=y

# ESP32-S3-MINI-1-N4R2 and other -R modules carry external PSRAM. Plain malloc
# is served from it above SPIRAM_MALLOC_ALWAYSINTERNAL; MALLOC_CAP_DMA
# allocations stay internal. IGNORE_NOTFOUND keeps modules without PSRAM booting.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Plain allocations below this come out of internal RAM, which is only ~300K
# and is also the only place FreeRTOS task stacks and DMA buffers can live.
# At 4096 the 1K chunk binaries a partition read produces landed there and
# accumulated as garbage - AtomVM's heap is in PSRAM, so nothing made it
# collect - until a websocket client could not allocate its task.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# TLS working memory lives in PSRAM. Internal RAM cannot hold it: DMA buffers
# must be internal, and a handshake under DEFAULT_MEM_ALLOC starved the LED
# driver's DMA allocation and crashed it mid-handshake.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Size the TLS record buffers to the handshake in progress rather than holding
# 16K in and 4K out for the life of every connection.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# libsodium's Ed25519 verification overflows the 3584-byte default main task
# stack. The symptom is a reset on the first update, not a bad-signature report.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384


# ngrok's edge negotiates TLS 1.3 by default and refuses the legacy 1.2-only
# ClientHello mbedTLS sends without this, closing before any alert.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# -Og left the VM at 98.2% of `factory`, which TLS 1.3 then overflowed by 384
# bytes. Assertions are a separate knob and stay on.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# A TLS handshake is seconds of ECC on this core, and some proxy edges will
# not wait (ngrok's https edge hangs up ~1s after its server flight, measured
# with a stalled-handshake proxy). 240MHz keeps the handshake short; the rest
# of the answer is terminating TLS somewhere without a deadline and keeping
# the chain P-256 (see avm_badge_server/priv/cert).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Bluetooth LE keyboard (components/atomvm_ble_hid): NimBLE, peripheral only.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
# The host's heap lives in PSRAM; the controller stays in internal RAM.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_MESH=n
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_SVC_GAP_APPEARANCE=0x3C1
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# The controller lives in internal RAM; a peripheral needs neither scanning,
# test mode nor six activities (828 bytes each).
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# On the S3, IRAM and the heap share one SRAM: wifi code in flash and its
# buffers in PSRAM leave room for the Bluetooth controller.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
